menu5[0]='<a href="http://www.javascriptkit.com">JavaScript Kit</a>'
menu5[1]='<a href="http://www.freewarejava.com">Freewarejava.com</a>'
menu5[2]='<a href="http://codingforums.com">Coding Forums</a>'
